      <th>Flag Value</th>
    </tr>
    <tr>
      <td><strong>SQL Injection</strong></td>
      <td>Catalog Search UNION SELECT</td>
      <td><code>BLITZ{5ql1_un10n_d8_3xf1l_9f82c4a17e}</code></td>
    </tr>
    <tr>
      <td><strong>Cross-Site Scripting</strong></td>
      <td>Search / Feedback Script Injection</td>
      <td><code>BLITZ{x55_cl13nt_3x3c_7b39d104fa}</code></td>
    </tr>
    <tr>
      <td><strong>Brute Force Compromise</strong></td>
      <td>Login Portal (admin / dragon123)</td>
      <td><code>BLITZ{bruf3_4uth_c0mpr0m153_6e1a4d88}</code></td>
    </tr>
    <tr>
      <td><strong>Incident Correlation</strong></td>
      <td>SIEM Advanced Analysis</td>
      <td><code>BLITZ{1nc1d3nt_c0rr3l4t10n_89c2e01b}</code></td>
    </tr>
  </table>

